@functions {
    public static string GetTablerIcon(string key) => key switch
    {
        "" => "ti-dashboard",
        "registrations" => "ti-user-check",
        "contracts" => "ti-file-certificate",
        "rooms" => "ti-bed",
        "buildings" => "ti-building",
        "services" => "ti-sparkles",
        "repairs" => "ti-tools",
        "rules" => "ti-book",
        "guests" => "ti-users-group",
        "assets" => "ti-box",
        "meters" => "ti-gauge",
        "utilities" => "ti-bolt",
        "violations" => "ti-alert-triangle",
        "payments" => "ti-receipt-2",
        "deposits" => "ti-wallet",
        "refunds" => "ti-receipt-refund",
        "reports" => "ti-chart-bar",
        "notifications" => "ti-bell",
        "users" => "ti-user-cog",
        _ => "ti-circle"
    };
}
@{
    var isStudent = User.IsInRole("student") && !User.IsInRole("system_admin") && !User.IsInRole("dorm_manager");
    var isAdmin = User.IsInRole("system_admin") || User.IsInRole("dorm_manager");
    var isAccountant = User.IsInRole("accountant");
    var isMaintenance = User.IsInRole("maintenance_staff");
    var active = ViewData["ActiveSection"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var nav = new (string Key, string Label, string Group)[]
    {
        ("", "Tổng quan", "Điều hành & Lưu trú"),
        ("registrations", "Xét duyệt đăng ký", "Điều hành & Lưu trú"),
        ("contracts", "Hợp đồng & Nhận/trả phòng", "Điều hành & Lưu trú"),
        ("rooms", "Phòng & Giường", "Không gian"),
        ("buildings", "Tòa nhà ký túc xá", "Không gian"),
        ("assets", "Tài sản thiết bị", "Không gian"),
        ("meters", "Công tơ điện nước", "Không gian"),
        ("services", "Danh mục dịch vụ", "Vận hành"),
        ("repairs", "Điều phối sửa chữa", "Vận hành"),
        ("rules", "Nội quy ký túc xá", "Vận hành"),
        ("guests", "Sổ khách thăm", "Vận hành"),
        ("utilities", "Chốt số điện nước", "Tài chính"),
        ("payments", "Hóa đơn & Thu phí", "Tài chính"),
        ("deposits", "Tiền cọc lưu trú", "Tài chính"),
        ("refunds", "Hoàn trả tiền cọc", "Tài chính"),
        ("reports", "Báo cáo thống kê", "Tài chính"),
        ("violations", "Kỷ luật vi phạm", "Hệ thống"),
        ("notifications", "Thông báo nội bộ", "Hệ thống"),
        ("users", "Phân quyền người dùng", "Hệ thống")
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1e293b" />
    <title>@(ViewData["Title"] ?? "Ký túc xá") · Quản lý Nội trú</title>

    <!-- Google Fonts: Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Tabler Core CSS & Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "layout-fluid" : "d-flex flex-column bg-white")">
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="page">
        <!-- Sidebar Navigation (Tabler Vertical) -->
        <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark bg-dark border-end-0">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Bật/tắt thanh điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Brand / Logo -->
                <h1 class="navbar-brand navbar-brand-autodark py-2 my-0">
                    <a asp-controller="Dormitory" asp-action="Index" class="d-flex align-items-center text-decoration-none text-white">
                        <span class="avatar avatar-sm bg-primary text-white rounded me-2">
                            <i class="ti ti-building-community fs-2"></i>
                        </span>
                        <span class="d-flex flex-column text-start">
                            <strong class="fs-3 fw-bold text-white tracking-wide">QUẢN LÝ NỘI TRÚ</strong>
                            <small class="text-white-50 fs-6">Ký túc xá Đại học</small>
                        </span>
                    </a>
                </h1>

                <!-- Mobile User Quick Avatar -->
                <div class="navbar-nav flex-row d-lg-none">
                    <div class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm px-2" title="Đăng xuất">
                                <i class="ti ti-logout fs-2"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Sidebar Body -->
                <div class="collapse navbar-collapse" id="sidebar-menu">
                    <!-- User Campus Role Pill -->
                    <div class="px-3 py-2 my-2 rounded bg-dark-lt border border-white-10 d-flex align-items-center justify-content-between">
                        <span class="badge @(isStudent ? "bg-cyan-lt text-cyan" : "bg-primary-lt text-primary") fw-medium">
                            @(isStudent ? "Sinh viên" : isAdmin ? "Ban Quản lý KTX" : isAccountant ? "Kế toán" : "Kỹ thuật viên")
                        </span>
                        <span class="badge bg-secondary-lt text-white-50">CS-HN</span>
                    </div>

                    <!-- Navigation Groups -->
                    <ul class="navbar-nav pt-lg-2">
                        @foreach (var group in nav.GroupBy(x => x.Group))
                        {
                            var visible = group.Where(x => isStudent ? x.Key is not ("reports" or "users" or "buildings" or "assets" or "meters" or "utilities") : isAdmin || x.Key == "notifications" || (isAccountant && x.Key is ("" or "payments" or "deposits" or "refunds" or "reports")) || (isMaintenance && x.Key is ("" or "rooms" or "repairs" or "assets" or "meters" or "utilities"))).ToList();
                            if (visible.Count == 0) { continue; }

                            <li class="nav-item text-uppercase text-white-50 fw-semibold px-3 pt-3 pb-1 fs-6 tracking-wider">
                                @group.Key
                            </li>

                            @foreach (var item in visible)
                            {
                                var href = string.IsNullOrEmpty(item.Key) ? Url.Action("Index", "Dormitory") : Url.Action("Workspace", "Dormitory", new { section = item.Key });
                                var isCurrent = active == item.Key && (item.Key.Length > 0 || currentAction == "Index");
                                <li class="nav-item @(isCurrent ? "active" : "")">
                                    <a class="nav-link py-2 @(isCurrent ? "fw-bold text-white bg-primary-lt" : "text-white-75")" href="@href">
                                        <span class="nav-link-icon d-inline-block me-2">
                                            <i class="ti @GetTablerIcon(item.Key) fs-2"></i>
                                        </span>
                                        <span class="nav-link-title">@item.Label</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Sidebar Footer User Profile -->
                    <div class="mt-auto pt-3 border-top border-white-10">
                        <div class="d-flex align-items-center p-2 rounded bg-dark-lt">
                            <span class="avatar avatar-sm bg-primary text-white rounded-circle me-2 fw-bold">
                                @(User.Identity?.Name?.Split(' ').LastOrDefault()?.FirstOrDefault() ?? 'Q')
                            </span>
                            <div class="flex-fill text-truncate me-2">
                                <div class="text-white text-truncate fw-medium fs-5">@User.Identity?.Name</div>
                                <div class="text-white-50 fs-6">@(isStudent ? "Tài khoản sinh viên" : "Quản trị viên")</div>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-icon btn-ghost-light btn-sm text-white-50" title="Đăng xuất" aria-label="Đăng xuất">
                                    <i class="ti ti-logout fs-2"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Shell -->
        <div class="page-wrapper">
            <!-- Topbar Header -->
            <header class="navbar navbar-expand-md d-none d-lg-flex d-print-none border-bottom bg-white sticky-top py-2">
                <div class="container-xl">
                    <!-- Breadcrumb -->
                    <div class="d-flex align-items-center">
                        <span class="text-muted fs-5 me-2">Ký túc xá</span>
                        <span class="text-muted me-2">/</span>
                        <span class="fw-bold text-dark fs-4">@(ViewData["Title"] ?? "Tổng quan")</span>
                    </div>

                    <!-- Topbar Right Actions -->
                    <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
                        <!-- Date Badge -->
                        <div class="me-3">
                            <span class="badge bg-light text-secondary border px-3 py-2 fw-normal fs-6">
                                <i class="ti ti-calendar me-1"></i>
                                @DateTime.Today.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
                            </span>
                        </div>

                        <!-- User Profile Chip -->
                        <div class="d-flex align-items-center me-3">
                            <span class="avatar avatar-sm bg-primary-lt text-primary rounded-circle fw-bold me-2">
                                @(User.Identity?.Name?.Split(' ').LastOrDefault()?.FirstOrDefault() ?? 'Q')
                            </span>
                            <div class="d-flex flex-column">
                                <span class="fw-semibold text-dark fs-5 leading-1">@User.Identity?.Name</span>
                                <small class="text-muted fs-6">@(isStudent ? "Sinh viên" : "Quản trị viên")</small>
                            </div>
                        </div>

                        <!-- Direct Logout -->
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Đăng xuất khỏi hệ thống">
                                <i class="ti ti-logout me-1"></i> Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <div class="page-body my-3">
                <div class="container-xl">
                    <!-- Notifications / Alerts -->
                    @if (TempData["Notice"] is string notice)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-circle-check fs-1 text-success me-2"></i>
                                <div>@notice</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                        </div>
                    }
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-alert-triangle fs-1 text-danger me-2"></i>
                                <div>@error</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                        </div>
                    }

                    <!-- Core Page Content -->
                    @RenderBody()
                </div>
            </div>

            <!-- Tabler Modern Footer -->
            <footer class="footer footer-transparent d-print-none py-3 border-top bg-white mt-auto">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-item"><span class="badge bg-green-lt text-green"><i class="ti ti-point-filled"></i> Máy chủ hoạt động tốt</span></li>
                                <li class="list-inline-item"><a href="#" class="link-secondary">Hỗ trợ nội trú</a></li>
                                <li class="list-inline-item"><a href="#" class="link-secondary">Quy định KTX</a></li>
                            </ul>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <ul class="list-inline list-inline-dots mb-0 text-muted">
                                <li class="list-inline-item">
                                    © @DateTime.Now.Year <strong>Hệ thống Quản lý Ký túc xá</strong>. Bản quyền thuộc Ban Quản lý KTX Đại học.
                                </li>
                                <li class="list-inline-item">
                                    Nền tảng Tabler Bootstrap 5
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<!-- Tabler Core JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/js/tabler.min.js" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
