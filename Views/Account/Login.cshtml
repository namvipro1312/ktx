@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="login-layout">
    <section class="login-visual"><a class="brand login-brand" asp-controller="Account" asp-action="Login"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span><strong>NỘI TRÚ</strong><small>QUẢN LÝ KHU NỘI TRÚ</small></span></a><div class="login-route" aria-hidden="true"><span class="login-route-line"></span><i class="login-node node-red"></i><i class="login-node node-blue"></i><i class="login-node node-amber"></i><i class="login-node node-green"></i></div><div class="login-visual-copy"><h1>Một hành trình<br />lưu trú rõ ràng.</h1><p>Từ lúc gửi đăng ký đến ngày trả phòng, mọi hồ sơ đều có bước tiếp theo.</p></div><div class="login-visual-foot"><span>HỆ THỐNG QUẢN LÝ KÝ TÚC XÁ</span><span>01 — 05 · NỘI TRÚ</span></div></section>
    <section class="login-form-wrap"><div class="login-form-card"><div class="login-mobile-brand"><span class="brand-mark"><span></span><span></span><span></span></span><strong>NỘI TRÚ</strong></div><h2>Đăng nhập</h2><p class="login-subtitle">Dùng tài khoản được cấp để tiếp tục.</p>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
            <label class="field"><span>Tên đăng nhập</span><input name="username" autocomplete="username" required autofocus placeholder="Nhập tên đăng nhập" /></label>
            <label class="field"><span>Mật khẩu</span><input name="password" type="password" autocomplete="current-password" required placeholder="Nhập mật khẩu" /></label>
            <button class="button button-primary login-submit" type="submit">Vào hệ thống <span aria-hidden="true">→</span></button>
        </form>
        @if (ViewData["ShowDemoCredentials"] as bool? == true) { <div class="demo-credentials"><div class="demo-credentials-head"><span class="demo-dot"></span><strong>TÀI KHOẢN DÙNG THỬ</strong></div><div><span>Quản trị</span><code>admin</code><span class="credential-separator">/</span><code>Demo@123</code></div><div><span>Sinh viên</span><code>sv001</code><span class="credential-separator">/</span><code>Demo@123</code></div><p>Chỉ dùng trên môi trường phát triển. Đổi mật khẩu và xóa dữ liệu demo trước khi triển khai.</p></div> }
    </div><footer class="login-copyright">Bản phát triển · Kết nối cơ sở dữ liệu ký túc xá</footer></section>
</div>
