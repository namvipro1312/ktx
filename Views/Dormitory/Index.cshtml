                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "rules" })" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <span class="avatar avatar-sm bg-secondary-lt text-secondary rounded me-3">
                            <i class="ti ti-book fs-2"></i>
                        </span>
                        <div class="flex-fill">
                            <div class="fw-bold text-dark fs-5">Nội quy ký túc xá</div>
