                            <h3 class="card-title fw-bold mb-0">Không gian phòng ở của bạn</h3>
                            <p class="card-subtitle text-muted mb-0 fs-6">Chi tiết nơi lưu trú, giường ở và danh sách bạn cùng phòng.</p>
                        </div>
                    </div>
                    @if (Model.StudentRoom is not null)
                    {
                        <div class="btn-list">
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#dormPassModal">
                                <i class="ti ti-qrcode me-1"></i> Thẻ KTX điện tử
                            </button>
                            <a href="@Url.Action("Workspace", "Dormitory", new { section = "contracts" })" class="btn btn-sm btn-outline-primary">
                                Hợp đồng chi tiết <i class="ti ti-arrow-right ms-1"></i>
