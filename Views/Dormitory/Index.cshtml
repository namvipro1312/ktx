</div>

@if (Model.IsStudent && Model.StudentRoom is not null)
{
    <!-- MODAL: THẺ KÝ TÚC XÁ ĐIỆN TỬ (DIGITAL DORM PASS) -->
    <div class="modal fade" id="dormPassModal" tabindex="-1" aria-labelledby="dormPassModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent">
                <div class="dorm-pass-card p-4 text-center">
                    <!-- Hologram Strip -->
                    <div class="dorm-pass-hologram mb-3"></div>

                    <!-- Header -->
                    <div class="d-flex align-items-center justify-content-between mb-3 text-start">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-sm bg-primary text-white rounded me-2">
                                <i class="ti ti-building-community fs-3"></i>
                            </span>
                            <div>
                                <div class="fs-6 fw-bold tracking-wide text-uppercase" style="letter-spacing: 0.08em; color: #94a3b8;">KÝ TÚC XÁ ĐẠI HỌC</div>
                                <div class="fs-4 fw-bold text-white">THẺ NỘI TRÚ ĐIỆN TỬ</div>
                            </div>
                        </div>
                        <span class="badge bg-success-lt text-success fw-bold px-2 py-1">
                            <i class="ti ti-circle-check me-1"></i> HỢP LỆ
                        </span>
                    </div>

                    <!-- Student Profile Section -->
                    <div class="p-3 rounded mb-3 text-start" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <div class="d-flex align-items-center mb-3">
                            <span class="avatar avatar-lg bg-primary text-white rounded-circle me-3 fw-bold fs-2" style="border: 2px solid #38bdf8;">
                                @(Model.StudentRoom.StudentName.Split(' ').LastOrDefault()?.FirstOrDefault() ?? 'S')
                            </span>
                            <div class="flex-fill">
                                <h3 class="fw-bold text-white mb-0 fs-3">@Model.StudentRoom.StudentName</h3>
                                <div class="text-cyan fs-5 fw-semibold">MSSV: @Model.StudentRoom.StudentCode</div>
                                <div class="text-white-50 fs-6">@Model.StudentRoom.Faculty (K@(Model.StudentRoom.CourseYear))</div>
                            </div>
                        </div>

                        <!-- Room Details Grid -->
                        <div class="row g-2 pt-2 border-top border-white-10 text-center">
                            <div class="col-4">
                                <div class="text-white-50 fs-6">Tòa nhà</div>
                                <div class="fw-bold fs-5 text-white">@Model.StudentRoom.BuildingName</div>
                            </div>
                            <div class="col-4">
                                <div class="text-white-50 fs-6">Phòng</div>
                                <div class="fw-bold fs-4 text-warning">P.@Model.StudentRoom.RoomNumber</div>
                            </div>
                            <div class="col-4">
                                <div class="text-white-50 fs-6">Giường</div>
                                <div class="fw-bold fs-4 text-info">@Model.StudentRoom.BedNumber</div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic QR Code Container -->
                    <div class="mb-3">
                        <div class="dorm-pass-qr-wrap">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(Model.StudentRoom.PassCode)"
                                 alt="QR Thẻ KTX"
                                 width="180" height="180" class="img-fluid" />
                        </div>
                        <div class="text-white-50 fs-6 mt-2">
                            <i class="ti ti-scan me-1 text-cyan"></i> Quét mã này tại cổng bảo vệ & điểm danh ca đêm
                        </div>
                    </div>

                    <!-- Barcode Display -->
                    <div class="dorm-barcode text-center mb-3">
                        ||| | |||| || | |||| ||| |||| | |||| || |<br />
                        @Model.StudentRoom.StudentCode · @Model.StudentRoom.BuildingName-@Model.StudentRoom.RoomNumber-@Model.StudentRoom.BedNumber
                    </div>

                    <!-- Realtime Clock for Anti-Screenshot Fraud -->
                    <div class="p-2 rounded bg-dark-lt text-white-50 fs-6 d-flex align-items-center justify-content-between">
                        <span><i class="ti ti-clock me-1 text-warning"></i> Giờ hệ thống: <strong class="text-white" id="dormPassLiveClock">--:--:--</strong></span>
                        <span class="text-success fw-medium">Hạn: @Model.StudentRoom.EndDate.ToString("dd/MM/yyyy")</span>
                    </div>

                    <!-- Close / Actions -->
                    <div class="mt-3 d-flex gap-2">
                        <button type="button" class="btn btn-outline-light w-50" onclick="window.print()">
                            <i class="ti ti-printer me-1"></i> In thẻ
                        </button>
                        <button type="button" class="btn btn-primary w-50" data-bs-dismiss="modal">
                            Đóng thẻ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function updateDormPassClock() {
            var clockEl = document.getElementById('dormPassLiveClock');
            if (clockEl) {
                var now = new Date();
                var h = String(now.getHours()).padStart(2, '0');
                var m = String(now.getMinutes()).padStart(2, '0');
                var s = String(now.getSeconds()).padStart(2, '0');
                clockEl.textContent = h + ':' + m + ':' + s;
            }
        }
        setInterval(updateDormPassClock, 1000);
        updateDormPassClock();
    </script>
}
