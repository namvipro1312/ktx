                                </div>
                                <div class="progress progress-sm mb-3" style="height: 8px;">
                                    <div class="progress-bar bg-primary" style="width: 10%" role="progressbar" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="row text-center g-2 pt-1 border-top">
                                    <div class="col-3">
                                        <div class="text-muted fs-6">Phòng</div>
                                        <div class="fw-bold fs-5 text-dark">2</div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted fs-6">Tổng chỗ</div>
                                        <div class="fw-bold fs-5 text-dark">10</div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted fs-6">Đang ở</div>
                                        <div class="fw-bold fs-5 text-primary">1</div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted fs-6">Còn trống</div>
                                        <div class="fw-bold fs-5 text-success">9</div>
                                    </div>
