@model DashboardViewModel
@{
    ViewData["Title"] = Model.IsStudent ? "Không gian lưu trú" : "Tổng quan vận hành";
}

<!-- Page Header -->
<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle text-muted text-uppercase">
                @(Model.IsStudent ? "CỔNG THÔNG TIN SINH VIÊN" : "TRUNG TÂM ĐIỀU HÀNH KÝ TÚC XÁ")
            </div>
            <h2 class="page-title text-dark fw-bold">
                @(Model.IsStudent ? $"Chào bạn, {Model.DisplayName}" : "Tổng quan điều hành ký túc xá")
            </h2>
            <p class="text-muted mb-0">
                @(Model.IsStudent ? "Theo dõi phòng ở, hợp đồng lưu trú, hóa đơn và gửi yêu cầu hỗ trợ sinh viên." : "Theo dõi công suất phòng ở, hồ sơ đăng ký và các công việc cần xử lý hôm nay.")
            </p>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
                @if (Model.IsStudent)
                {
                    <a class="btn btn-outline-primary" asp-controller="Dormitory" asp-action="Workspace" asp-route-section="repairs">
                        <i class="ti ti-tools me-1"></i> Báo hỏng sửa chữa
                    </a>
                    <a class="btn btn-primary" asp-controller="Dormitory" asp-action="Workspace" asp-route-section="registrations">
                        <i class="ti ti-pencil-plus me-1"></i> Đăng ký phòng mới
                    </a>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Dormitory" asp-action="Workspace" asp-route-section="registrations">
                        <i class="ti ti-clipboard-list me-1"></i> Hàng chờ xét duyệt (@Model.PendingRegistrations)
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.IsStudent && Model.StudentRoom is not null)
{
    <!-- MODAL: THẺ KÝ TÚC XÁ ĐIỆN TỬ (DIGITAL DORM PASS) -->
    <div class="modal fade" id="dormPassModal" tabindex="-1" aria-labelledby="dormPassModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent">
                <div class="dorm-pass-card p-4 text-center">
                    <!-- Hologram Strip -->
                    <div class="dorm-pass-hologram mb-3"></div>

                    <!-- Header -->
                    <div class="d-flex align-items-center justify-content-between mb-3 text-start">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-sm bg-primary text-white rounded me-2">
                                <i class="ti ti-building-community fs-3"></i>
                            </span>
                            <div>
                                <div class="fs-6 fw-bold tracking-wide text-uppercase" style="letter-spacing: 0.08em; color: #94a3b8;">KÝ TÚC XÁ ĐẠI HỌC</div>
                                <div class="fs-4 fw-bold text-white">THẺ NỘI TRÚ ĐIỆN TỬ</div>
                            </div>
                        </div>
                        <span class="badge bg-success-lt text-success fw-bold px-2 py-1">
                            <i class="ti ti-circle-check me-1"></i> HỢP LỆ
                        </span>
                    </div>

                    <!-- Student Profile Section -->
                    <div class="p-3 rounded mb-3 text-start" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <div class="d-flex align-items-center mb-3">
                            <span class="avatar avatar-lg bg-primary text-white rounded-circle me-3 fw-bold fs-2" style="border: 2px solid #38bdf8;">
                                @(Model.StudentRoom.StudentName.Split(' ').LastOrDefault()?.FirstOrDefault() ?? 'S')
                            </span>
                            <div class="flex-fill">
                                <h3 class="fw-bold text-white mb-0 fs-3">@Model.StudentRoom.StudentName</h3>
                                <div class="text-cyan fs-5 fw-semibold">MSSV: @Model.StudentRoom.StudentCode</div>
                                <div class="text-white-50 fs-6">@Model.StudentRoom.Faculty (K@(Model.StudentRoom.CourseYear))</div>
                            </div>
                        </div>

                        <!-- Room Details Grid -->
                        <div class="row g-2 pt-2 border-top border-white-10 text-center">
                            <div class="col-4">
                                <div class="text-white-50 fs-6">Tòa nhà</div>
                                <div class="fw-bold fs-5 text-white">@Model.StudentRoom.BuildingName</div>
                            </div>
                            <div class="col-4">
                                <div class="text-white-50 fs-6">Phòng</div>
                                <div class="fw-bold fs-4 text-warning">P.@Model.StudentRoom.RoomNumber</div>
                            </div>
                            <div class="col-4">
                                <div class="text-white-50 fs-6">Giường</div>
                                <div class="fw-bold fs-4 text-info">@Model.StudentRoom.BedNumber</div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic QR Code Container -->
                    <div class="mb-3">
                        <div class="dorm-pass-qr-wrap">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(Model.StudentRoom.PassCode)"
                                 alt="QR Thẻ KTX"
                                 width="180" height="180" class="img-fluid" />
                        </div>
                        <div class="text-white-50 fs-6 mt-2">
                            <i class="ti ti-scan me-1 text-cyan"></i> Quét mã này tại cổng bảo vệ & điểm danh ca đêm
                        </div>
                    </div>

                    <!-- Barcode Display -->
                    <div class="dorm-barcode text-center mb-3">
                        ||| | |||| || | |||| ||| |||| | |||| || |<br />
                        @Model.StudentRoom.StudentCode · @Model.StudentRoom.BuildingName-@Model.StudentRoom.RoomNumber-@Model.StudentRoom.BedNumber
                    </div>

                    <!-- Realtime Clock for Anti-Screenshot Fraud -->
                    <div class="p-2 rounded bg-dark-lt text-white-50 fs-6 d-flex align-items-center justify-content-between">
                        <span><i class="ti ti-clock me-1 text-warning"></i> Giờ hệ thống: <strong class="text-white" id="dormPassLiveClock">--:--:--</strong></span>
                        <span class="text-success fw-medium">Hạn: @Model.StudentRoom.EndDate.ToString("dd/MM/yyyy")</span>
                    </div>

                    <!-- Close / Actions -->
                    <div class="mt-3 d-flex gap-2">
                        <button type="button" class="btn btn-outline-light w-50" onclick="window.print()">
                            <i class="ti ti-printer me-1"></i> In thẻ
                        </button>
                        <button type="button" class="btn btn-primary w-50" data-bs-dismiss="modal">
                            Đóng thẻ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function updateDormPassClock() {
            var clockEl = document.getElementById('dormPassLiveClock');
            if (clockEl) {
                var now = new Date();
                var h = String(now.getHours()).padStart(2, '0');
                var m = String(now.getMinutes()).padStart(2, '0');
                var s = String(now.getSeconds()).padStart(2, '0');
                clockEl.textContent = h + ':' + m + ':' + s;
            }
        }
        setInterval(updateDormPassClock, 1000);
        updateDormPassClock();
    </script>
}

<!-- KPI Stat Cards Row -->
<div class="row row-cards g-3 mb-4">
    @if (Model.IsStudent)
    {
        <!-- Sinh viên Card 1: Phòng đang ở hoặc Giường trống -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-primary h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-primary-lt text-primary rounded">
                                <i class="ti ti-home fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Phòng ở của bạn</div>
                            @if (Model.StudentRoom is not null)
                            {
                                <div class="h2 mb-0 fw-bold text-dark">@Model.StudentRoom.RoomNumber <small class="fs-6 text-muted font-weight-normal">· Giường @Model.StudentRoom.BedNumber</small></div>
                                <div class="text-muted fs-6 mt-1 text-truncate">@Model.StudentRoom.BuildingName · @Model.StudentRoom.RoomType</div>
                            }
                            else
                            {
                                <div class="h2 mb-0 fw-bold text-muted">Chưa xếp phòng</div>
                                <div class="text-muted fs-6 mt-1">Còn @Model.AvailableBeds chỗ sẵn sàng</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = Model.StudentRoom is not null ? "contracts" : "rooms" })" class="text-primary fs-6 fw-medium text-decoration-none">
                        @(Model.StudentRoom is not null ? "Xem hợp đồng phòng" : "Tra cứu phòng trống") <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sinh viên Card 2: Đơn đăng ký của bạn -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-warning h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-warning-lt text-warning rounded">
                                <i class="ti ti-file-pencil fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Hồ sơ đăng ký</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.PendingRegistrations.ToString("00") <small class="fs-6 text-muted font-weight-normal">đơn</small></div>
                            <div class="text-muted fs-6 mt-1">@(Model.PendingRegistrations > 0 ? "Đang chờ BQL xét duyệt" : "Chưa có đơn chờ duyệt")</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "registrations" })" class="text-warning fs-6 fw-medium text-decoration-none">
                        Xem đơn đăng ký <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sinh viên Card 3: Hợp đồng lưu trú -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-success h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-success-lt text-success rounded">
                                <i class="ti ti-file-certificate fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Hợp đồng lưu trú</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.ActiveContracts.ToString("00") <small class="fs-6 text-muted font-weight-normal">hợp đồng</small></div>
                            <div class="text-muted fs-6 mt-1">@(Model.ActiveContracts > 0 ? "Đang có hiệu lực lưu trú" : "Chưa có hợp đồng")</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "contracts" })" class="text-success fs-6 fw-medium text-decoration-none">
                        Xem hợp đồng của bạn <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sinh viên Card 4: Số dư cần nộp -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-danger h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-danger-lt text-danger rounded">
                                <i class="ti ti-receipt-2 fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Cần thanh toán</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.Outstanding.ToString("N0") <small class="fs-6 text-muted font-weight-normal">đ</small></div>
                            <div class="text-muted fs-6 mt-1">@(Model.Outstanding > 0 ? "Số tiền bạn cần nộp" : "Đã thanh toán đủ, không nợ")</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "payments" })" class="text-danger fs-6 fw-medium text-decoration-none">
                        Chi tiết hóa đơn <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Admin / Ban Quản trị Card 1: Giường còn trống -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-primary h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-primary-lt text-primary rounded">
                                <i class="ti ti-bed fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Giường còn trống</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.AvailableBeds.ToString("00") <small class="fs-6 text-muted font-weight-normal">chỗ</small></div>
                            <div class="text-muted fs-6 mt-1">Sẵn sàng đón sinh viên</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "rooms" })" class="text-primary fs-6 fw-medium text-decoration-none">
                        Xem danh sách phòng <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Admin Card 2: Hồ sơ chờ duyệt -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-warning h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-warning-lt text-warning rounded">
                                <i class="ti ti-user-check fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Hồ sơ chờ duyệt</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.PendingRegistrations.ToString("00") <small class="fs-6 text-muted font-weight-normal">đơn</small></div>
                            <div class="text-muted fs-6 mt-1">Cần ban quản lý xét duyệt</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "registrations" })" class="text-warning fs-6 fw-medium text-decoration-none">
                        Xử lý hồ sơ ngay <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Admin Card 3: Hợp đồng lưu trú -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-success h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-success-lt text-success rounded">
                                <i class="ti ti-file-certificate fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Hợp đồng lưu trú</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.ActiveContracts.ToString("00") <small class="fs-6 text-muted font-weight-normal">hợp đồng</small></div>
                            <div class="text-muted fs-6 mt-1">Sinh viên đang ở thực tế</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "contracts" })" class="text-success fs-6 fw-medium text-decoration-none">
                        Quản lý hợp đồng <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Admin Card 4: Tổng công nợ -->
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm shadow-sm border-0 border-start border-3 border-danger h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="avatar avatar-md bg-danger-lt text-danger rounded">
                                <i class="ti ti-receipt-2 fs-1"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="text-muted fs-6 fw-medium text-uppercase">Số dư hóa đơn</div>
                            <div class="h2 mb-0 fw-bold text-dark">@Model.Outstanding.ToString("N0") <small class="fs-6 text-muted font-weight-normal">đ</small></div>
                            <div class="text-muted fs-6 mt-1">Tổng công nợ chưa thu</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent py-1 px-3 border-top-0">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "payments" })" class="text-danger fs-6 fw-medium text-decoration-none">
                        Chi tiết hóa đơn <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Workflow Stations Ribbon -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-white py-2">
        <div class="d-flex align-items-center">
            <i class="ti ti-route text-primary me-2 fs-2"></i>
            <h3 class="card-title fs-4 mb-0 fw-bold">@(Model.IsStudent ? "Hành trình lưu trú nội trú" : "Luồng công tác nội trú")</h3>
        </div>
    </div>
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            @for (var i = 0; i < Model.Stations.Count; i++)
            {
                var station = Model.Stations[i];
                var href = Url.Action("Workspace", "Dormitory", new { section = station.Key, station = station.Key });
                <div class="col-6 col-sm-4 col-md-3 col-lg">
                    <a href="@href" class="card card-sm card-link shadow-none border bg-light text-decoration-none p-2 text-center d-block h-100 hover-card">
                        <div class="text-muted fs-6 text-truncate">@station.Label</div>
                        <div class="fs-3 fw-bold text-primary">@station.Count.ToString("00")</div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Main 2-Column Section -->
<div class="row g-4">
    <!-- Left Column: Tasks Queue & Room Information (8 cols) -->
    <div class="col-lg-8">
        <!-- Card: Tasks Queue -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <i class="ti ti-list-check text-primary me-2 fs-2"></i>
                    <div>
                        <h3 class="card-title fw-bold mb-0">@(Model.IsStudent ? "Yêu cầu & Công việc của bạn" : "Hàng chờ cần xử lý trong hôm nay")</h3>
                        <p class="card-subtitle text-muted mb-0 fs-6">
                            @(Model.IsStudent ? "Theo dõi tiến độ xử lý hồ sơ đăng ký, phản ánh sửa chữa và tình trạng thanh toán." : "Các công việc yêu cầu sự phê duyệt hoặc phối hợp từ ban quản lý.")
                        </p>
                    </div>
                </div>
                <a href="@Url.Action("Workspace", "Dormitory", new { section = Model.IsStudent ? "registrations" : "registrations" })" class="btn btn-sm btn-outline-primary">
                    Mở toàn bộ <i class="ti ti-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Nội dung công việc</th>
                            <th>Mã tham chiếu / Chi tiết</th>
                            <th>Trạng thái</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Tasks.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="ti ti-clipboard-check fs-1 text-success d-block mb-2"></i>
                                    <strong>@(Model.IsStudent ? "Bạn không có yêu cầu nào tồn đọng" : "Hiện không có việc tồn đọng cần xử lý")</strong>
                                    <p class="mb-0 fs-6 text-muted">@(Model.IsStudent ? "Phòng ở và các dịch vụ của bạn đang hoạt động bình thường." : "Mọi yêu cầu nội trú đã được xử lý xong.")</p>
                                </td>
                            </tr>
                        }
                        @foreach (var task in Model.Tasks)
                        {
                            var badgeClass = task.State.Contains("Chờ") || task.State.Contains("Cần") ? "bg-warning-lt text-warning"
                                           : task.State.Contains("Đã") ? "bg-success-lt text-success"
                                           : "bg-blue-lt text-blue";
                            <tr>
                                <td>
                                    <span class="status-dot @(task.State.Contains("Chờ") ? "status-dot-animated bg-warning" : "bg-success") me-2"></span>
                                    <strong class="text-dark">@task.Title</strong>
                                </td>
                                <td class="text-muted fs-6">
                                    @task.Detail
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@task.State</span>
                                </td>
                                <td class="text-end">
                                    <a href="@task.Href" class="btn btn-sm btn-outline-secondary px-2 py-1" title="Xem chi tiết">
                                        <i class="ti ti-arrow-up-right fs-2"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.IsStudent)
        {
