                    <div class="d-flex align-items-center">
                        <i class="ti ti-bolt text-warning me-2 fs-2"></i>
                        <h3 class="card-title fw-bold mb-0">Thao tác nghiệp vụ nhanh</h3>
                    </div>
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "rooms" })#create-form" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <span class="avatar avatar-sm bg-primary-lt text-primary rounded me-3">
                            <i class="ti ti-plus fs-2"></i>
                        </span>
                        <div class="flex-fill">
                            <div class="fw-bold text-dark fs-5">Thêm phòng / chỗ ở mới</div>
                            <div class="text-muted fs-6">Thiết lập mã phòng, tòa, sức chứa</div>
                        </div>
                        <i class="ti ti-chevron-right text-muted"></i>
                    </a>

                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "payments" })#create-form" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <span class="avatar avatar-sm bg-success-lt text-success rounded me-3">
                            <i class="ti ti-receipt fs-2"></i>
                        </span>
                        <div class="flex-fill">
                            <div class="fw-bold text-dark fs-5">Lập hóa đơn định kỳ</div>
                            <div class="text-muted fs-6">Tính tiền phòng và dịch vụ tháng</div>
                        </div>
                        <i class="ti ti-chevron-right text-muted"></i>
                    </a>

                    <a href="@Url.Action("Workspace", "Dormitory", new { section = "utilities" })#create-form" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <span class="avatar avatar-sm bg-warning-lt text-warning rounded me-3">
                            <i class="ti ti-bolt fs-2"></i>
                        </span>
                        <div class="flex-fill">
                            <div class="fw-bold text-dark fs-5">Ghi chỉ số điện nước</div>
                            <div class="text-muted fs-6">Tự động phân bổ sản lượng theo phòng</div>
                        </div>
