            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Dormitory" asp-action="Process" method="post">
                        <input type="hidden" name="section" value="registrations" />
                        <input type="hidden" name="id" id="reqChangesId" value="" />
                        <input type="hidden" name="operation" value="request-changes" />
                        <div class="modal-header bg-info text-white">
                            <h5 class="modal-title fw-bold"><i class="ti ti-edit-circle me-2"></i>Yêu cầu bổ sung hồ sơ / Minh chứng</h5>
                            <button type="button" class="btn-close btn-close-white" onclick="closeRequestChangesModal()" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="p-3 bg-light rounded mb-3">
                                <div>Mã hồ sơ: <strong id="reqChangesModalCode" class="text-dark"></strong></div>
                                <div>Sinh viên: <strong id="reqChangesModalStudent" class="text-info"></strong></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Lý do yêu cầu bổ sung (Sinh viên sẽ nhận được thông báo):</label>
                                <textarea name="comment" rows="3" class="form-control" required
                                          placeholder="Ví dụ: Ảnh chụp sổ hộ nghèo bị mờ, không thấy dấu đỏ; hoặc thiếu thông tin người liên hệ khẩn cấp..."></textarea>
                            </div>
                            <div class="form-hint text-muted">Hồ sơ sẽ chuyển về trạng thái <strong>Cần bổ sung</strong> để sinh viên sửa lại và nộp tiếp.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-link link-secondary" onclick="closeRequestChangesModal()">Đóng</button>
                            <button type="submit" class="btn btn-info text-white">Gửi yêu cầu bổ sung</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL 3: CHUYỂN VÀO DANH SÁCH CHỜ (WAITLIST) -->
        <div id="modalWaitlist" class="modal modal-blur fade show" style="display:none; background:rgba(15,23,42,0.6);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Dormitory" asp-action="Process" method="post">
                        <input type="hidden" name="section" value="registrations" />
                        <input type="hidden" name="id" id="waitlistId" value="" />
                        <input type="hidden" name="operation" value="waitlist" />
                        <div class="modal-header bg-purple text-white">
                            <h5 class="modal-title fw-bold"><i class="ti ti-clock me-2"></i>Chuyển vào Danh sách chờ (Waitlist)</h5>
                            <button type="button" class="btn-close btn-close-white" onclick="closeWaitlistModal()" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="p-3 bg-light rounded mb-3">
                                <div>Mã hồ sơ: <strong id="waitlistModalCode" class="text-dark"></strong></div>
                                <div>Sinh viên: <strong id="waitlistModalStudent" class="text-purple"></strong></div>
                            </div>
                            <p class="text-muted">
                                Hồ sơ này đủ điều kiện nhưng hiện đã hết chỉ tiêu loại phòng yêu cầu. Hồ sơ sẽ được giữ thứ tự ưu tiên trong Danh sách chờ và sẽ được đôn lên ngay khi có sinh viên khác bị hủy hoặc nhả phòng.
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-link link-secondary" onclick="closeWaitlistModal()">Đóng</button>
                            <button type="submit" class="btn btn-purple text-white">Xác nhận đưa vào Danh sách chờ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL 4: TỪ CHỐI HỒ SƠ (REJECT) -->
        <div id="modalReject" class="modal modal-blur fade show" style="display:none; background:rgba(15,23,42,0.6);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Dormitory" asp-action="Process" method="post">
                        <input type="hidden" name="section" value="registrations" />
                        <input type="hidden" name="id" id="rejectRegId" value="" />
                        <input type="hidden" name="operation" value="reject" />
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title fw-bold"><i class="ti ti-alert-triangle me-2"></i>Từ chối hồ sơ đăng ký phòng</h5>
                            <button type="button" class="btn-close btn-close-white" onclick="closeRejectModal()" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="p-3 bg-light rounded mb-3">
                                <div>Mã hồ sơ: <strong id="rejectModalCode" class="text-dark"></strong></div>
                                <div>Sinh viên: <strong id="rejectModalStudent" class="text-danger"></strong></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Lý do từ chối hồ sơ</label>
                                <textarea name="comment" rows="3" class="form-control" required placeholder="Nêu rõ lý do: Hồ sơ không hợp lệ, vi phạm kỷ luật nghiêm trọng các kỳ trước, không thuộc diện tiếp nhận..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-link link-secondary" onclick="closeRejectModal()">Đóng</button>
                            <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL 5: XEM MINH CHỨNG TRỰC TIẾP (IN-APP PROOF PREVIEW) -->
        <div id="modalProofPreview" class="modal modal-blur fade show" style="display:none; background:rgba(15,23,42,0.7);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold"><i class="ti ti-file-certificate text-primary me-2"></i>Thẩm định file minh chứng ưu tiên</h5>
                            <div class="text-muted fs-6" id="proofModalInfo"></div>
                        </div>
                        <button type="button" class="btn-close" onclick="closeProofPreviewModal()" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center p-3" style="max-height:70vh; overflow-y:auto;">
                        <div id="proofViewerContainer">
                            <img id="proofPreviewImg" src="" alt="Minh chứng" class="img-fluid rounded border shadow-sm" style="max-height:60vh; display:none;" />
                            <div id="proofPdfNotice" style="display:none;" class="p-4 bg-light rounded">
                                <i class="ti ti-file-text fs-1 text-primary d-block mb-2"></i>
                                <h5>Tệp minh chứng định dạng PDF</h5>
                                <a id="proofPdfLink" href="#" target="_blank" class="btn btn-primary btn-sm">
                                    <i class="ti ti-external-link me-1"></i> Mở xem file PDF trong tab mới
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <span class="text-muted fs-6"><i class="ti ti-shield-check text-success me-1"></i>Đối soát dấu mộc đỏ, thông tin hộ nghèo, thương binh liệt sĩ</span>
                        <button type="button" class="btn btn-secondary" onclick="closeProofPreviewModal()">Đóng</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- JAVASCRIPT ĐIỀU KHIỂN BỘ LỌC ĐA CHIỀU & CÁC MODAL -->
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const searchInput = document.getElementById("regFilterSearch");
                const statusSelect = document.getElementById("regFilterStatus");
                const prioritySelect = document.getElementById("regFilterPriority");
                const roomTypeSelect = document.getElementById("regFilterRoomType");
                const countLabel = document.getElementById("regFilterCount");
                const rows = document.querySelectorAll("#regTable tbody tr.reg-row");

                function applyRegFilters() {
                    const searchVal = (searchInput?.value || "").trim().toLowerCase();
                    const statusVal = statusSelect?.value || "all";
                    const priorityVal = prioritySelect?.value || "all";
                    const roomTypeVal = roomTypeSelect?.value || "all";

                    let visibleCount = 0;
                    rows.forEach(row => {
                        const rowSearch = row.getAttribute("data-search") || "";
                        const rowStatus = row.getAttribute("data-status") || "";
                        const rowScore = row.getAttribute("data-score") || "";
                        const rowRoomType = row.getAttribute("data-roomtype") || "";

                        const matchSearch = !searchVal || rowSearch.includes(searchVal);
                        const matchStatus = statusVal === "all" || rowStatus === statusVal;
                        const matchPriority = priorityVal === "all" || rowScore === priorityVal;
                        const matchRoomType = roomTypeVal === "all" || rowRoomType === roomTypeVal;

                        const isMatch = matchSearch && matchStatus && matchPriority && matchRoomType;
                        row.style.display = isMatch ? "" : "none";
                        if (isMatch) visibleCount++;
                    });

                    if (countLabel) {
                        countLabel.innerText = `Hiển thị ${visibleCount} / ${rows.length} hồ sơ`;
                    }
                }

                searchInput?.addEventListener("input", applyRegFilters);
                statusSelect?.addEventListener("change", applyRegFilters);
                prioritySelect?.addEventListener("change", applyRegFilters);
                roomTypeSelect?.addEventListener("change", applyRegFilters);
            });

            // Modal Handlers
            function openApproveModal(id, code, student, bldg, rtype, score, priorityTag) {
                document.getElementById('approveRegId').value = id;
                document.getElementById('approveModalCode').innerText = code;
                document.getElementById('approveModalStudent').innerText = student;
                document.getElementById('approveModalPref').innerText = bldg + ' · ' + rtype;
                document.getElementById('approveModalScore').innerText = score + ' điểm (' + priorityTag + ')';
                document.getElementById('modalApprove').style.display = 'block';
            }
            function closeApproveModal() {
                document.getElementById('modalApprove').style.display = 'none';
            }

            function openRequestChangesModal(id, code, student) {
                document.getElementById('reqChangesId').value = id;
                document.getElementById('reqChangesModalCode').innerText = code;
                document.getElementById('reqChangesModalStudent').innerText = student;
                document.getElementById('modalRequestChanges').style.display = 'block';
            }
            function closeRequestChangesModal() {
                document.getElementById('modalRequestChanges').style.display = 'none';
            }

            function openWaitlistModal(id, code, student) {
                document.getElementById('waitlistId').value = id;
                document.getElementById('waitlistModalCode').innerText = code;
                document.getElementById('waitlistModalStudent').innerText = student;
                document.getElementById('modalWaitlist').style.display = 'block';
            }
            function closeWaitlistModal() {
                document.getElementById('modalWaitlist').style.display = 'none';
            }

            function openRejectModal(id, code, student) {
                document.getElementById('rejectRegId').value = id;
                document.getElementById('rejectModalCode').innerText = code;
                document.getElementById('rejectModalStudent').innerText = student;
                document.getElementById('modalReject').style.display = 'block';
            }
            function closeRejectModal() {
                document.getElementById('modalReject').style.display = 'none';
            }

            function openProofPreviewModal(code, student, priorityTag, score, fileUrl) {
                document.getElementById('proofModalInfo').innerText = `${student} (${code}) · Diện: ${priorityTag} (${score} điểm)`;
                const imgEl = document.getElementById('proofPreviewImg');
                const pdfNotice = document.getElementById('proofPdfNotice');
                const pdfLink = document.getElementById('proofPdfLink');

                if (fileUrl.toLowerCase().endsWith('.pdf')) {
                    imgEl.style.display = 'none';
                    pdfNotice.style.display = 'block';
                    pdfLink.href = fileUrl;
                } else {
                    imgEl.src = fileUrl;
                    imgEl.style.display = 'inline-block';
                    pdfNotice.style.display = 'none';
                }
                document.getElementById('modalProofPreview').style.display = 'block';
            }
            function closeProofPreviewModal() {
                document.getElementById('modalProofPreview').style.display = 'none';
            }
        </script>
    }
}

<!-- ============================================== -->
<!-- 3. GENERAL DATA TABLES (ALL OTHER SECTIONS)   -->
<!-- ============================================== -->
@if (!Model.RoomGroups.Any() && Model.Section != "registrations")
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-md-5">
                    <h3 class="card-title fw-bold mb-0">
                        <i class="ti ti-table text-primary me-2"></i>
                        @(Model.Section == "repairs" ? "Yêu cầu sửa chữa mới nhất" : Model.Section == "rooms" ? "Danh sách chi tiết phòng" : "Danh sách bản ghi hiện có")
                    </h3>
                </div>
                <div class="col-md-7 text-md-end">
                    <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                        <input type="search" class="form-control form-control-sm w-auto" data-table-search placeholder="Tìm mã, tên hoặc nội dung..." autocomplete="off" />
                        <select class="form-select form-select-sm w-auto" data-table-status>
                            <option value="">Tất cả trạng thái</option>
                            @foreach (var state in Model.Rows.Select(x => x.State).Distinct().OrderBy(x => x))
                            {
                                <option value="@state">@DormitoryController.StatusText(state)</option>
                            }
                        </select>
                        <span class="badge bg-secondary-lt fs-6">
                            <span data-visible-count>@Model.Rows.Count</span> / @Model.Rows.Count bản ghi
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.Rows.Any())
        {
            <div class="card-body text-center py-5">
                <i class="ti ti-database-off fs-1 text-muted d-block mb-2"></i>
                <h3 class="fw-bold text-dark">Chưa có dữ liệu trong mục này</h3>
                <p class="text-muted mb-0">Khi phát sinh hồ sơ hoặc nghiệp vụ, các bản ghi sẽ hiển thị tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover table-striped">
                    <thead>
                        <tr>
                            @foreach (var column in Model.Columns)
                            {
                                <th>@column</th>
                            }
                            @if (Model.Rows.Any(x => x.Actions.Count > 0) || Model.Section is "contracts" or "payments" or "deposits")
                            {
                                <th class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rowState = row.State;
                            var badgeClass = rowState.Contains("contracted") || rowState.Contains("paid") || rowState.Contains("active") || rowState.Contains("resolved") || rowState.Contains("completed") ? "bg-success-lt text-success"
                                           : rowState.Contains("pending") || rowState.Contains("unpaid") || rowState.Contains("in_progress") ? "bg-warning-lt text-warning"
                                           : rowState.Contains("rejected") || rowState.Contains("cancelled") || rowState.Contains("overdue") ? "bg-danger-lt text-danger"
                                           : "bg-secondary-lt text-secondary";

                            <tr class="row-state-@row.State" data-filter-row data-row-state="@row.State">
                                <td class="fw-semibold text-dark">@row.Cells.ElementAtOrDefault(0)</td>
                                @for (var cellIndex = 1; cellIndex < row.Cells.Count; cellIndex++)
                                {
                                    <td>
                                        @if (cellIndex == row.Cells.Count - 1 && Model.Section != "reports")
                                        {
                                            <span class="badge @badgeClass">@row.Cells[cellIndex]</span>
                                        }
                                        else
                                        {
                                            @row.Cells[cellIndex]
                                        }
                                    </td>
                                }
                                @if (Model.Rows.Any(x => x.Actions.Count > 0) || Model.Section is "contracts" or "payments" or "deposits")
                                {
                                    <td class="text-center">
                                        <div class="btn-list justify-content-center">
                                            @if (Model.Section == "contracts")
                                            {
                                                <a asp-controller="Dormitory" asp-action="ContractView" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary" target="_blank">
                                                    <i class="ti ti-file-text me-1"></i> Xem văn bản
                                                </a>
                                            }
                                            else if (Model.Section == "payments" && row.Cells.Count >= 7)
                                            {
                                                var invCode = row.Cells[0];
                                                var remaining = row.Cells.Count >= 6 ? row.Cells[5] : "0 ₫";
                                                <button type="button" class="btn btn-sm btn-outline-success" 
                                                        onclick="openVietQRModal('@invCode', '@remaining', 'KTX @invCode')">
                                                    <i class="ti ti-qrcode me-1"></i> Quét VietQR
                                                </button>
                                            }
                                            else if (Model.Section == "deposits" && row.Cells.Count >= 5)
                                            {
                                                var txCode = row.Cells[0];
                                                var contractCode = row.Cells[1];
                                                var amount = row.Cells[4];
                                                <button type="button" class="btn btn-sm btn-outline-success" 
                                                        onclick="openVietQRModal('@txCode', '@amount', 'COC @contractCode')">
                                                    <i class="ti ti-qrcode me-1"></i> Quét VietQR
                                                </button>
                                            }
                                            @foreach (var action in row.Actions)
                                            {
                                                <form asp-controller="Dormitory" asp-action="Process" method="post" class="m-0">
                                                    <input type="hidden" name="section" value="@Model.Section" />
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    <input type="hidden" name="operation" value="@action.Operation" />
                                                    <button class="btn btn-sm @(action.Primary ? "btn-primary" : "btn-outline-secondary")" type="submit">
                                                        @action.Label
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-muted" data-filter-empty hidden>
                <i class="ti ti-info-circle me-1"></i> Không có bản ghi nào khớp với điều kiện lọc.
            </div>
        }
    </div>
}

<!-- ============================================== -->
<!-- 4. CREATE / ACTION FORM CARD                  -->
<!-- ============================================== -->
@if (Model.Section == "registrations" && Model.FormTitle is not null)
{
    <!-- DEDICATED ROOM REGISTRATION FORM (THEO 7 NHÓM BẢNG TỔNG HỢP CHI TIẾT) -->
    <div class="card shadow-sm border-0 mb-4" id="create-form">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex align-items-center">
                <span class="avatar avatar-md bg-primary-lt text-primary rounded me-3">
                    <i class="ti ti-file-pencil fs-1"></i>
                </span>
                <div>
                    <h3 class="card-title fw-bold mb-0">Đơn Đăng Ký Lưu Trú Ký Túc Xá</h3>
                    <small class="text-muted">Hoàn thiện đầy đủ các nhóm thông tin bên dưới để Ban Quản lý xét duyệt chỗ ở và lập hợp đồng.</small>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Dormitory" asp-action="Create" method="post" enctype="multipart/form-data">
                <!-- Group 7: Dữ liệu hệ thống ẩn -->
                <input type="hidden" name="section" value="registrations" />
                <input type="hidden" name="periodId" value="2026-2027" />
                <input type="hidden" name="formType" value="student_detailed_v2" />

                <!-- ========================================== -->
                <!-- NHÓM 1: NGUYỆN VỌNG PHÒNG                  -->
                <!-- ========================================== -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-blue text-white rounded-circle p-2 me-2">1</span>
                        <h4 class="fw-bold text-dark mb-0 fs-3">Nguyện vọng phòng ở</h4>
                    </div>
                    <div class="row g-3 p-3 rounded bg-light border">
                        <!-- Tòa nhà mong muốn -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Tòa nhà mong muốn <small class="text-muted">(Lọc theo khu Nam / Nữ)</small>
                            </label>
                            <select name="buildingId" class="form-select">
                                <option value="">-- Tự động phân bổ theo giới tính (Tòa A: Nam, Tòa B: Nữ) --</option>
                                <option value="1">Tòa A · Khu Nam (Cơ sở chính)</option>
                                <option value="2">Tòa B · Khu Nữ (Cơ sở chính)</option>
                            </select>
                        </div>

                        <!-- Loại phòng nguyện vọng (*) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Loại phòng nguyện vọng <span class="text-danger">*</span>
                            </label>
                            <select name="roomType" class="form-select" required>
                                <option value="4 người">Phòng 4 người (Tiêu chuẩn · Điều hòa & Nóng lạnh · 650.000 ₫/tháng)</option>
                                <option value="6 người">Phòng 6 người (Tiết kiệm · Nóng lạnh & Quạt trần · 520.000 ₫/tháng)</option>
                                <option value="2 người">Phòng 2 người (Chất lượng cao VIP · Đầy đủ tiện nghi · 1.200.000 ₫/tháng)</option>
                                <option value="8 người">Phòng 8 người (Tập thể sinh viên · 420.000 ₫/tháng)</option>
                            </select>
                        </div>

                        <!-- Vị trí giường mong muốn -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Vị trí giường mong muốn
                            </label>
                            <select name="bedPosition" class="form-select">
                                <option value="none">-- Không yêu cầu (BQL tự sắp xếp) --</option>
                                <option value="Giường tầng dưới (Tầng 1)">Giường tầng dưới (Tầng 1 - Thuận tiện đi lại)</option>
                                <option value="Giường tầng trên (Tầng 2)">Giường tầng trên (Tầng 2 - Yên tĩnh, thoáng gió)</option>
                            </select>
                        </div>

                        <!-- Tầng mong muốn -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Tầng mong muốn
                            </label>
                            <select name="floorPreference" class="form-select">
                                <option value="none">-- Không yêu cầu (BQL tự sắp xếp) --</option>
                                <option value="Tầng thấp (Tầng 1 - 3)">Tầng thấp (Tầng 1 - 3 · Thuận tiện di chuyển)</option>
                                <option value="Tầng cao (Tầng 4 - 6)">Tầng cao (Tầng 4 - 6 · View đẹp, thoáng đãng, yên tĩnh)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- NHÓM 2: THỜI GIAN LƯU TRÚ                  -->
                <!-- ========================================== -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-teal text-white rounded-circle p-2 me-2">2</span>
                        <h4 class="fw-bold text-dark mb-0 fs-3">Thời gian lưu trú dự kiến</h4>
                    </div>
                    <div class="row g-3 p-3 rounded bg-light border">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Ngày bắt đầu lưu trú <span class="text-danger">*</span>
                                <small class="text-muted d-block fs-6">Mốc tính tiền phòng và bàn giao chìa khóa</small>
                            </label>
                            <input type="date" name="startDate" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Ngày kết thúc lưu trú <span class="text-danger">*</span>
                                <small class="text-muted d-block fs-6">Hạn kết thúc hợp đồng theo năm học (chuẩn 10 tháng)</small>
                            </label>
                            <input type="date" name="endDate" class="form-control" required value="@DateTime.Now.AddMonths(10).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- NHÓM 3: ĐỐI TƯỢNG & MINH CHỨNG            -->
                <!-- ========================================== -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-warning text-white rounded-circle p-2 me-2">3</span>
                        <h4 class="fw-bold text-dark mb-0 fs-3">Đối tượng ưu tiên & Giấy tờ minh chứng</h4>
                    </div>
                    <div class="row g-3 p-3 rounded bg-light border">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Diện đối tượng ưu tiên chính sách
                            </label>
                            <select name="priority" id="regPrioritySelect" class="form-select">
                                <option value="Không">Không thuộc diện ưu tiên (Xét duyệt thông thường)</option>
                                <option value="Con thương binh, liệt sĩ / Gia đình có công">Con thương binh, liệt sĩ / Gia đình có công (Ưu tiên 1)</option>
                                <option value="Hộ nghèo, cận nghèo">Hộ nghèo, cận nghèo có giấy xác nhận (Ưu tiên 2)</option>
                                <option value="Sinh viên khuyết tật">Sinh viên khuyết tật (Ưu tiên 3)</option>
                                <option value="Vùng sâu, vùng xa, hải đảo">Vùng sâu, vùng xa, biên giới, hải đảo (Ưu tiên 4)</option>
                                <option value="Tân sinh viên năm nhất ngoại tỉnh">Tân sinh viên năm nhất ngoại tỉnh (Ưu tiên 5)</option>
                                <option value="Cán bộ Đoàn - Hội xuất sắc">Cán bộ Đoàn - Hội có thành tích xuất sắc (Ưu tiên 6)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Đính kèm file minh chứng <small class="text-muted">(Ảnh chụp hoặc file PDF)</small>
                                <small class="text-muted d-block fs-6">Cần thiết khi chọn diện chính sách ưu tiên (Tối đa 10MB)</small>
                            </label>
                            <input type="file" name="proofFile" id="regProofFileInput" class="form-control" accept=".pdf,.png,.jpg,.jpeg" />
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- NHÓM 4: HẬU CẦN & ĐỜI SỐNG                 -->
                <!-- ========================================== -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-indigo text-white rounded-circle p-2 me-2">4</span>
                        <h4 class="fw-bold text-dark mb-0 fs-3">Hậu cần & Nhu cầu đời sống</h4>
                    </div>
                    <div class="row g-3 p-3 rounded bg-light border">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Đăng ký gửi xe tại KTX</label>
                            <div class="d-flex gap-3 pt-2">
                                <label class="form-check form-check-inline m-0">
                                    <input class="form-check-input" type="radio" name="parkingRegister" value="no" checked id="parkOptNo" onchange="toggleVehicleInput(false)">
                                    <span class="form-check-label">Không gửi xe</span>
                                </label>
                                <label class="form-check form-check-inline m-0">
                                    <input class="form-check-input" type="radio" name="parkingRegister" value="yes" id="parkOptYes" onchange="toggleVehicleInput(true)">
                                    <span class="form-check-label text-primary fw-medium">Có gửi xe</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-8" id="vehiclePlateWrap" style="display:none;">
                            <label class="form-label fw-semibold">
                                Loại xe & Biển số xe <small class="text-muted">(Tích hợp thẻ xe & barrier quét biển)</small>
                            </label>
                            <input type="text" name="vehiclePlate" id="vehiclePlateInput" class="form-control" placeholder="VD: Xe máy Honda Wave Alpha - Biển số 29B1-678.90..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Ghi chú & Nguyện vọng bổ sung
                                <small class="text-muted font-weight-normal">(Nhập MSSV nếu muốn xếp chung phòng với bạn bè, yêu cầu giường, thiết bị...)</small>
                            </label>
                            <textarea name="note" rows="2" class="form-control" placeholder="VD: Muốn ở cùng bạn Nguyễn Văn A (MSSV: 20260002); mong muốn phòng thoáng gió..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- NHÓM 5: LIÊN HỆ AN TOÀN                    -->
                <!-- ========================================== -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-danger text-white rounded-circle p-2 me-2">5</span>
                        <h4 class="fw-bold text-dark mb-0 fs-3">Liên hệ an toàn khẩn cấp</h4>
                    </div>
                    <div class="row g-3 p-3 rounded bg-light border">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Họ tên người liên hệ khẩn cấp <span class="text-danger">*</span>
                                <small class="text-muted d-block fs-6">Họ tên bố, mẹ hoặc người giám hộ hợp pháp</small>
                            </label>
                            <input type="text" name="emergencyContactName" class="form-control" required placeholder="VD: Nguyễn Văn Nam (Bố)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Số điện thoại khẩn cấp <span class="text-danger">*</span>
                                <small class="text-muted d-block fs-6">Liên lạc khi có sự cố y tế hoặc an ninh nội trú</small>
                            </label>
                            <input type="tel" name="emergencyContactPhone" class="form-control" required pattern="[0-9]{10,11}" placeholder="VD: 0912345678" />
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- NHÓM 6: PHÁP LÝ & CAM KẾT                  -->
                <!-- ========================================== -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-dark text-white rounded-circle p-2 me-2">6</span>
                        <h4 class="fw-bold text-dark mb-0 fs-3">Pháp lý & Cam kết nội quy</h4>
                    </div>
                    <div class="p-3 rounded bg-blue-lt border border-primary-subtle">
                        <label class="form-check m-0">
                            <input class="form-check-input me-2" type="checkbox" name="policyAgreed" id="policyAgreedCheckbox" required value="true" />
                            <span class="form-check-label text-dark fs-5 fw-medium">
                                <strong>Tôi cam kết:</strong> Toàn bộ thông tin khai báo trong đơn là hoàn toàn chính xác. Tôi đã đọc, hiểu rõ và cam kết tuân thủ nghiêm túc <strong>Nội quy Ký túc xá</strong>, quy định giờ giấc giới nghiêm, nộp đầy đủ tiền phòng, tiền cọc và phí dịch vụ đúng thời hạn quy định.
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                    <button class="btn btn-primary btn-lg px-5 shadow-sm" type="submit">
                        <i class="ti ti-send me-2"></i> Gửi Đơn Đăng Ký Lưu Trú
                    </button>
                    <span class="text-muted fs-6"><span class="text-danger">*</span> Các trường có dấu sao đỏ là bắt buộc phải điền.</span>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleVehicleInput(show) {
            var wrap = document.getElementById('vehiclePlateWrap');
            var input = document.getElementById('vehiclePlateInput');
            if (wrap) {
                wrap.style.display = show ? 'block' : 'none';
                if (show && input) input.focus();
            }
        }
    </script>
}
else if (Model.FormTitle is not null && Model.Fields.Count > 0)
{
    <div class="card shadow-sm border-0 mb-4" id="create-form">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center">
                <span class="avatar avatar-sm bg-primary-lt text-primary rounded me-2">
                    <i class="ti ti-plus fs-2"></i>
                </span>
                <div>
                    <h3 class="card-title fw-bold mb-0">@Model.FormTitle</h3>
                    <small class="text-muted">@(Model.FormHelp ?? "Thông tin sẽ được ghi nhận vào hồ sơ vận hành hệ thống.")</small>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Dormitory" asp-action="Create" method="post">
                <input type="hidden" name="section" value="@Model.Section" />
                <div class="row g-3">
                    @foreach (var field in Model.Fields)
                    {
                        var isFullWidth = field.Type == "textarea" || field.Name.Contains("note") || field.Name.Contains("address");
                        <div class="@(isFullWidth ? "col-12" : "col-md-6 col-lg-4")">
                            <label class="form-label fw-semibold">
                                @field.Label
                                @if (field.Required)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @if (field.Type == "select")
                            {
                                <select name="@field.Name" class="form-select" required="@(field.Required ? "required" : null)">
                                    <option value="">-- Chọn @field.Label.ToLowerInvariant() --</option>
                                    @foreach (var option in field.Options)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                            }
                            else if (field.Type == "textarea")
                            {
                                <textarea name="@field.Name" rows="3" class="form-control" required="@(field.Required ? "required" : null)" placeholder="Nhập @field.Label.ToLowerInvariant()..."></textarea>
                            }
                            else
                            {
                                <input name="@field.Name" type="@field.Type" class="form-control" required="@(field.Required ? "required" : null)" min="@(field.Type == "number" ? "0" : null)" step="@(field.Type == "number" ? "any" : null)" placeholder="Nhập @field.Label.ToLowerInvariant()..." />
                            }
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center justify-content-between mt-4 pt-3 border-top">
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="ti ti-check me-1"></i> Lưu thông tin dữ liệu
                    </button>
                    <span class="text-muted fs-6"><span class="text-danger">*</span> Các trường có dấu sao là bắt buộc.</span>
                </div>
            </form>
        </div>
    </div>
}

