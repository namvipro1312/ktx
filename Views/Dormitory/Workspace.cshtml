@model ModuleViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveSection"] = Model.Section;
    var isAdmin = User.IsInRole("system_admin") || User.IsInRole("dorm_manager");
}

<!-- Workspace Page Header -->
<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle text-muted text-uppercase">PHÂN HỆ NGHIỆP VỤ</div>
            <h2 class="page-title text-dark fw-bold">@Model.Title</h2>
            <p class="text-muted mb-0">@Model.Description</p>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
                <span class="badge bg-secondary-lt fs-6 align-self-center py-2 px-3">
                    <i class="ti ti-database me-1"></i> @Model.CountLabel
                </span>
                @if (Model.FormTitle is not null)
                {
                    <a class="btn btn-primary" href="#create-form">
                        <i class="ti ti-plus me-1"></i> @Model.FormTitle
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. ROOMS SECTION: HIGH-DENSITY ROOM MATRIX -->
<!-- ========================================== -->
@if (Model.Section == "rooms" && Model.RoomGroups.Count > 0)
{
    <!-- Room Matrix Header & Filter Bar -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="card-title mb-0 fw-bold">
                        <i class="ti ti-layout-grid text-primary me-1"></i> Sơ đồ phòng trực quan (Matrix Floorplan)
                    </h3>
                    <small class="text-muted">Theo dõi tình trạng phòng và chỗ trống theo từng tòa nhà và tầng.</small>
                </div>
                <!-- Legend -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-success-lt text-success"><i class="ti ti-point-filled"></i> Còn chỗ trống</span>
                    <span class="badge bg-secondary-lt text-secondary"><i class="ti ti-point-filled"></i> Đã kín chỗ</span>
                    <span class="badge bg-warning-lt text-warning"><i class="ti ti-point-filled"></i> Đang bảo trì</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Buildings Loop -->
    @foreach (var building in Model.RoomGroups)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="badge bg-primary text-white me-2 fw-bold">TÒA @building.BuildingCode</span>
                    <h3 class="card-title fw-bold mb-0 text-dark">@building.BuildingName</h3>
                </div>
                <div class="text-muted fs-6">
                    @{
                        var totalRooms = building.Floors.Sum(f => f.Rooms.Count);
                        var totalAvail = building.Floors.Sum(f => f.Rooms.Sum(r => r.AvailableBeds));
                        var totalCap = building.Floors.Sum(f => f.Rooms.Sum(r => r.Capacity));
                    }
                    <span>@totalRooms phòng</span> · <span class="text-success fw-semibold">@totalAvail/@totalCap chỗ trống</span>
                </div>
            </div>

            <div class="card-body p-3">
                @foreach (var floor in building.Floors)
                {
                    <div class="floor-block mb-3">
                        <!-- Floor Divider -->
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-dark text-white px-2 py-1 fs-6 me-2">
                                <i class="ti ti-stairs me-1"></i> TẦNG @floor.FloorNumber
                            </span>
                            <div class="border-bottom flex-fill"></div>
                        </div>

                        <!-- Compact Room Grid (High Density) -->
                        <div class="row row-cards g-2">
                            @foreach (var room in floor.Rooms)
                            {
                                var isMaintenance = room.Status == "maintenance";
                                var isFull = room.AvailableBeds == 0;
                                var borderClass = isMaintenance ? "border-warning bg-warning-lt" : isFull ? "border-secondary-subtle bg-light" : "border-success-subtle bg-white";
                                var pillClass = isMaintenance ? "bg-warning text-white" : isFull ? "bg-secondary text-white" : "bg-success text-white";

                                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                    <div class="card card-sm shadow-none border @borderClass h-100">
                                        <div class="card-body p-2 d-flex flex-column justify-content-between">
                                            <!-- Room Top -->
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <strong class="fs-4 text-dark">@room.RoomNumber</strong>
                                                <span class="badge @pillClass px-1 py-0 fs-6">
                                                    @(isMaintenance ? "Bảo trì" : isFull ? "Kín" : $"{room.AvailableBeds}/{room.Capacity} trống")
                                                </span>
                                            </div>

                                            <!-- Room Meta -->
                                            <div class="text-muted fs-6 mb-1 text-truncate" title="@room.RoomType">
                                                <span>@room.RoomType</span>
                                            </div>
                                            <div class="text-primary fw-semibold fs-6 mb-2">
                                                @room.MonthlyPrice.ToString("N0") đ
                                            </div>

                                            <!-- Bed Chips / Dots -->
                                            <div class="d-flex flex-wrap gap-1 mb-2">
                                                @foreach (var bed in room.Beds)
                                                {
                                                    var isBedAvail = bed.Status == "available";
                                                    <span class="badge @(isBedAvail ? "bg-success text-white" : "bg-light text-muted border") px-1 py-0 fs-6"
                                                          title="Giường @bed.BedNumber: @(isBedAvail ? "Còn trống" : "Đã có sinh viên ở")">
                                                        <i class="ti ti-bed fs-6"></i> @bed.BedNumber
                                                    </span>
                                                }
                                            </div>

                                            <!-- Admin Toggle Button -->
                                            @if (isAdmin)
                                            {
                                                <div class="mt-auto pt-1 border-top border-secondary-subtle">
                                                    <form asp-controller="Dormitory" asp-action="Process" method="post" class="m-0">
                                                        <input type="hidden" name="section" value="rooms" />
                                                        <input type="hidden" name="id" value="@room.Id" />
                                                        <input type="hidden" name="operation" value="@(isMaintenance ? "room-open" : "room-maintenance")" />
                                                        <button class="btn btn-ghost-secondary btn-sm w-100 py-0 fs-6 text-truncate" type="submit">
                                                            @(isMaintenance ? "✓ Mở phòng" : "⚙ Bảo trì")
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<!-- ============================================== -->
<!-- 2. REGISTRATIONS SECTION: APPROVAL & TRACKING  -->
<!-- ============================================== -->
@if (Model.Section == "registrations")
{
    @if (Model.RegistrationStats is not null)
    {
        <!-- Stats Row -->
        <div class="row row-cards g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0 border-start border-3 border-primary">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-md bg-primary-lt text-primary rounded me-3">
                                <i class="ti ti-folders fs-1"></i>
                            </span>
                            <div>
                                <div class="text-muted fs-6">Tổng số hồ sơ</div>
                                <div class="h2 mb-0 fw-bold">@Model.RegistrationStats.TotalCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0 border-start border-3 border-warning">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-md bg-warning-lt text-warning rounded me-3">
                                <i class="ti ti-clock-hour-4 fs-1"></i>
                            </span>
                            <div>
                                <div class="text-muted fs-6">Chờ xét duyệt</div>
                                <div class="h2 mb-0 fw-bold text-warning">@Model.RegistrationStats.PendingCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0 border-start border-3 border-success">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-md bg-success-lt text-success rounded me-3">
                                <i class="ti ti-circle-check fs-1"></i>
                            </span>
                            <div>
                                <div class="text-muted fs-6">Đã duyệt & Xếp phòng</div>
                                <div class="h2 mb-0 fw-bold text-success">@Model.RegistrationStats.ContractedCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm shadow-sm border-0 border-start border-3 border-danger">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-md bg-danger-lt text-danger rounded me-3">
                                <i class="ti ti-circle-x fs-1"></i>
                            </span>
                            <div>
                                <div class="text-muted fs-6">Từ chối / Hủy</div>
                                <div class="h2 mb-0 fw-bold text-danger">@Model.RegistrationStats.RejectedCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- STUDENT VIEW: APPLICATION PROGRESS STEPPER -->
    @if (User.IsInRole("student") && !isAdmin)
    {
        var myReg = Model.Registrations.FirstOrDefault();
        if (myReg is null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center py-5">
                    <i class="ti ti-notes fs-1 text-muted d-block mb-3"></i>
                    <h3 class="fw-bold text-dark">Bạn chưa nộp đơn đăng ký phòng ký túc xá</h3>
                    <p class="text-muted mb-4">Hãy hoàn thành biểu mẫu đăng ký bên dưới để được Ban Quản lý xét duyệt chỗ ở.</p>
                    <a href="#create-form" class="btn btn-primary">
                        <i class="ti ti-pencil me-1"></i> Điền đơn đăng ký ngay
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="card-title fw-bold mb-0">Hồ sơ đăng ký nội trú của bạn: @myReg.RegistrationCode</h3>
                        <small class="text-muted">Nộp lúc @myReg.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div>
                        @{
                            var regBadge = myReg.Status == "contracted" ? "bg-success-lt text-success"
                                         : myReg.Status == "pending" ? "bg-warning-lt text-warning"
                                         : myReg.Status == "rejected" ? "bg-danger-lt text-danger"
                                         : "bg-secondary-lt text-secondary";
                        }
                        <span class="badge @regBadge fs-5 py-2 px-3">@DormitoryController.StatusText(myReg.Status)</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Progress Stepper -->
                    <div class="steps steps-counter steps-primary mb-4">
                        <div class="step-item active">
                            Nộp hồ sơ
                            <span class="step-item-description">@myReg.SubmittedAt.ToString("dd/MM")</span>
                        </div>
                        <div class="step-item @(myReg.Status != "pending" ? "active" : "")">
                            Xét duyệt BQL
                            <span class="step-item-description">@(myReg.Status == "pending" ? "Đang chờ" : myReg.Status == "contracted" ? "Đạt" : "Từ chối")</span>
                        </div>
                        <div class="step-item @(myReg.Status == "contracted" ? "active" : "")">
                            Xếp phòng & Lập HĐ
                            <span class="step-item-description">@(myReg.Status == "contracted" ? "Đã xếp phòng" : "Chờ duyệt")</span>
                        </div>
                        <div class="step-item @(myReg.Status == "contracted" && myReg.ContractId.HasValue ? "active" : "")">
                            Ký & Nhận phòng
                            <span class="step-item-description">Thủ tục nhận phòng</span>
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="row g-3 p-3 bg-light rounded mb-4">
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted fs-6">Tòa mong muốn:</div>
                            <div class="fw-bold text-dark fs-5">@myReg.PreferredBuildingName</div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted fs-6">Loại phòng:</div>
                            <div class="fw-bold text-dark fs-5">@myReg.PreferredRoomType</div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted fs-6">Thời hạn lưu trú:</div>
                            <div class="fw-bold text-dark fs-5">@myReg.StartDate.ToString("dd/MM/yyyy") — @myReg.EndDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="text-muted fs-6">Ghi chú & Diện ưu tiên:</div>
                            <div class="fw-bold text-dark fs-5">@(string.IsNullOrWhiteSpace(myReg.Note) ? "Tiêu chuẩn" : myReg.Note)</div>
                        </div>
                    </div>

                    <!-- Status Alerts -->
                    @if (myReg.Status == "contracted" && !string.IsNullOrWhiteSpace(myReg.AssignedBedInfo))
                    {
                        <div class="alert alert-success d-flex align-items-center justify-content-between p-3" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-party-popper fs-1 text-success me-3"></i>
                                <div>
                                    <h4 class="alert-heading mb-1 fw-bold">Chúc mừng! Bạn đã được duyệt phân phòng thành công!</h4>
                                    <div>Vị trí giường của bạn: <strong class="fs-4">@myReg.AssignedBedInfo</strong></div>
                                    @if (!string.IsNullOrWhiteSpace(myReg.ReviewComment))
                                    {
                                        <div class="mt-1 fst-italic">"Lời nhắn BQL: @myReg.ReviewComment"</div>
                                    }
                                </div>
                            </div>
                            <a class="btn btn-success" href="/Dormitory/Workspace?section=contracts">
                                <i class="ti ti-file-text me-1"></i> Xem Hợp đồng & Nộp cọc →
                            </a>
                        </div>
                    }
                    else if (myReg.Status == "rejected")
                    {
                        <div class="alert alert-danger d-flex align-items-center p-3" role="alert">
                            <i class="ti ti-alert-triangle fs-1 text-danger me-3"></i>
                            <div>
                                <h4 class="alert-heading mb-1 fw-bold">Hồ sơ chưa được duyệt</h4>
                                <div>Lý do: <strong>@(string.IsNullOrWhiteSpace(myReg.ReviewComment) ? "Chưa đáp ứng điều kiện chỉ tiêu đợt này." : myReg.ReviewComment)</strong></div>
                                <div class="text-muted fs-6 mt-1">Bạn có thể nộp lại đơn đăng ký khác ở biểu mẫu bên dưới.</div>
                            </div>
                        </div>
                    }
                    else if (myReg.Status == "pending")
                    {
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="text-muted fs-6">Hồ sơ đang được Ban Quản lý đối soát chỉ tiêu giường. Bạn có thể hủy nếu đổi ý.</span>
                            <form asp-controller="Dormitory" asp-action="Process" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đăng ký phòng này?');">
                                <input type="hidden" name="section" value="registrations" />
                                <input type="hidden" name="id" value="@myReg.Id" />
                                <input type="hidden" name="operation" value="registration-cancel" />
                                <button class="btn btn-outline-danger btn-sm" type="submit">
                                    <i class="ti ti-x me-1"></i> Hủy đơn đăng ký này
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- ADMIN / MANAGER VIEW: APPROVAL TABLE -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <div class="row align-items-center g-2">
                    <div class="col-md-4">
                        <h3 class="card-title fw-bold mb-0">
                            <i class="ti ti-clipboard-check text-primary me-2"></i> Danh sách hồ sơ đăng ký phòng cần xét duyệt
                        </h3>
                    </div>
                    <div class="col-md-8 text-md-end">
                        <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                            @if (Model.RegistrationStats?.PendingCount > 0)
                            {
                                <form asp-controller="Dormitory" asp-action="Process" method="post" class="m-0" onsubmit="return confirm('Hệ thống sẽ tự động duyệt và xếp giường cho tất cả hồ sơ đang chờ có phòng phù hợp. Tiếp tục?');">
                                    <input type="hidden" name="section" value="registrations" />
                                    <input type="hidden" name="id" value="0" />
                                    <input type="hidden" name="operation" value="auto-allocate-all" />
                                    <button class="btn btn-warning btn-sm" type="submit">
                                        <i class="ti ti-bolt me-1"></i> Tự động duyệt tất cả (@Model.RegistrationStats.PendingCount đơn)
                                    </button>
                                </form>
                            }
                            <input type="search" class="form-control form-control-sm w-auto" data-table-search placeholder="Tìm sinh viên, mã hồ sơ..." autocomplete="off" />
                            <select class="form-select form-select-sm w-auto" data-table-status>
                                <option value="">Tất cả trạng thái</option>
                                <option value="pending">Chờ xử lý</option>
                                <option value="contracted">Đã phân giường</option>
                                <option value="rejected">Từ chối</option>
                                <option value="cancelled">Đã hủy</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.Registrations.Any())
            {
                <div class="card-body text-center py-5">
                    <i class="ti ti-inbox fs-1 text-muted d-block mb-2"></i>
                    <h3 class="fw-bold text-dark">Chưa có hồ sơ đăng ký phòng nào</h3>
                    <p class="text-muted mb-0">Khi sinh viên nộp đơn đăng ký chỗ ở, hồ sơ sẽ hiển thị tại đây để Ban quản lý xét duyệt.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Mã hồ sơ</th>
                                <th>Sinh viên</th>
                                <th>Nguyện vọng</th>
                                <th>Thời hạn</th>
                                <th>Ưu tiên / Ghi chú</th>
                                <th>Trạng thái</th>
                                <th>Giường phân bổ</th>
                                <th class="text-center">Thao tác xét duyệt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.Registrations)
                            {
                                var isPending = reg.Status == "pending";
                                var statusBadge = reg.Status == "contracted" ? "bg-success-lt text-success"
                                                : reg.Status == "pending" ? "bg-warning-lt text-warning"
                                                : reg.Status == "rejected" ? "bg-danger-lt text-danger"
                                                : "bg-secondary-lt text-secondary";

                                <tr class="row-state-@reg.Status" data-filter-row data-row-state="@reg.Status">
                                    <td>
                                        <strong class="text-dark">@reg.RegistrationCode</strong>
                                        <div class="text-muted fs-6">@reg.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@reg.StudentName</div>
                                        <div class="text-muted fs-6">MSV: @reg.StudentCode · @reg.Gender · @reg.Faculty</div>
                                        <div class="text-muted fs-6">SĐT: @reg.Phone</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-primary">@reg.PreferredBuildingName</div>
                                        <div class="text-muted fs-6">Loại: @reg.PreferredRoomType</div>
                                    </td>
                                    <td>
                                        <div class="text-dark">@reg.StartDate.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted fs-6">đến @reg.EndDate.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width:160px;" title="@reg.Note">
                                            @(string.IsNullOrWhiteSpace(reg.Note) ? "—" : reg.Note)
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @statusBadge">@DormitoryController.StatusText(reg.Status)</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(reg.AssignedBedInfo))
                                        {
                                            <span class="badge bg-teal-lt text-teal">
                                                <i class="ti ti-bed me-1"></i> @reg.AssignedBedInfo
                                            </span>
                                        }
                                        else if (reg.Status == "rejected")
                                        {
                                            <span class="text-danger fs-6 fw-semibold" title="@reg.ReviewComment">
                                                ✕ @(string.IsNullOrWhiteSpace(reg.ReviewComment) ? "Từ chối" : reg.ReviewComment)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-6">Chưa phân</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (isPending)
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-success" onclick="openApproveModal(@reg.Id, '@reg.RegistrationCode', '@reg.StudentName', '@reg.PreferredBuildingName', '@reg.PreferredRoomType')">
                                                    <i class="ti ti-check me-1"></i> Duyệt
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" onclick="openRejectModal(@reg.Id, '@reg.RegistrationCode', '@reg.StudentName')">
                                                    <i class="ti ti-x me-1"></i> Từ chối
                                                </button>
                                            </div>
                                        }
                                        else if (reg.ContractId.HasValue)
                                        {
                                            <a class="btn btn-outline-primary btn-sm" href="/Dormitory/ContractView/@reg.ContractId.Value">
                                                Xem HĐ <i class="ti ti-arrow-right ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-6">Đã xử lý</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- MODAL APPROVE -->
        <div id="modalApprove" class="modal modal-blur fade show" style="display:none; background:rgba(15,23,42,0.6);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Dormitory" asp-action="Process" method="post">
                        <input type="hidden" name="section" value="registrations" />
                        <input type="hidden" name="id" id="approveRegId" value="" />
                        <input type="hidden" name="operation" value="approve" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold"><i class="ti ti-check text-success me-2"></i>Duyệt hồ sơ & Phân bổ giường KTX</h5>
                            <button type="button" class="btn-close" onclick="closeApproveModal()" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="p-3 bg-light rounded mb-3">
                                <div>Mã hồ sơ: <strong id="approveModalCode" class="text-dark"></strong></div>
                                <div>Sinh viên: <strong id="approveModalStudent" class="text-primary"></strong></div>
                                <div>Nguyện vọng: <span id="approveModalPref" class="text-muted"></span></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Chọn giường phân bổ</label>
                                <select name="bedId" id="approveBedSelect" class="form-select">
                                    <option value="0">⚡ Tự động tìm giường phù hợp nhất</option>
                                    @foreach (var bed in Model.AvailableBedsList)
                                    {
                                        <option value="@bed.BedId">@bed.DisplayLabel</option>
                                    }
                                </select>
                                <small class="form-hint">Nếu để mặc định, hệ thống tự động tìm giường theo đúng tòa và loại phòng nguyện vọng.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Lời dặn / Ghi chú gửi sinh viên</label>
                                <textarea name="comment" rows="3" class="form-control" placeholder="Ví dụ: Đã duyệt phân phòng theo nguyện vọng. Vui lòng hoàn tất nộp cọc..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-link link-secondary" onclick="closeApproveModal()">Đóng</button>
                            <button type="submit" class="btn btn-success">
                                <i class="ti ti-check me-1"></i> Xác nhận duyệt & Tạo hợp đồng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL REJECT -->
        <div id="modalReject" class="modal modal-blur fade show" style="display:none; background:rgba(15,23,42,0.6);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Dormitory" asp-action="Process" method="post">
                        <input type="hidden" name="section" value="registrations" />
                        <input type="hidden" name="id" id="rejectRegId" value="" />
                        <input type="hidden" name="operation" value="reject" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold text-danger"><i class="ti ti-alert-triangle text-danger me-2"></i>Từ chối hồ sơ đăng ký</h5>
                            <button type="button" class="btn-close" onclick="closeRejectModal()" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="p-3 bg-light rounded mb-3">
                                <div>Mã hồ sơ: <strong id="rejectModalCode" class="text-dark"></strong></div>
                                <div>Sinh viên: <strong id="rejectModalStudent" class="text-danger"></strong></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Lý do từ chối hồ sơ</label>
                                <textarea name="comment" rows="3" class="form-control" required placeholder="Nêu rõ lý do: Hết chỉ tiêu phòng, không thuộc diện ưu tiên..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-link link-secondary" onclick="closeRejectModal()">Đóng</button>
                            <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            function openApproveModal(id, code, student, bldg, rtype) {
                document.getElementById('approveRegId').value = id;
                document.getElementById('approveModalCode').innerText = code;
                document.getElementById('approveModalStudent').innerText = student;
                document.getElementById('approveModalPref').innerText = bldg + ' · ' + rtype;
                document.getElementById('modalApprove').style.display = 'block';
            }
            function closeApproveModal() {
                document.getElementById('modalApprove').style.display = 'none';
            }
            function openRejectModal(id, code, student) {
                document.getElementById('rejectRegId').value = id;
                document.getElementById('rejectModalCode').innerText = code;
                document.getElementById('rejectModalStudent').innerText = student;
                document.getElementById('modalReject').style.display = 'block';
            }
            function closeRejectModal() {
                document.getElementById('modalReject').style.display = 'none';
            }
        </script>
    }
}

<!-- ============================================== -->
<!-- 3. GENERAL DATA TABLES (ALL OTHER SECTIONS)   -->
<!-- ============================================== -->
@if (!Model.RoomGroups.Any() && Model.Section != "registrations")
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center g-2">
                <div class="col-md-5">
                    <h3 class="card-title fw-bold mb-0">
                        <i class="ti ti-table text-primary me-2"></i>
                        @(Model.Section == "repairs" ? "Yêu cầu sửa chữa mới nhất" : Model.Section == "rooms" ? "Danh sách chi tiết phòng" : "Danh sách bản ghi hiện có")
                    </h3>
                </div>
                <div class="col-md-7 text-md-end">
                    <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                        <input type="search" class="form-control form-control-sm w-auto" data-table-search placeholder="Tìm mã, tên hoặc nội dung..." autocomplete="off" />
                        <select class="form-select form-select-sm w-auto" data-table-status>
                            <option value="">Tất cả trạng thái</option>
                            @foreach (var state in Model.Rows.Select(x => x.State).Distinct().OrderBy(x => x))
                            {
                                <option value="@state">@DormitoryController.StatusText(state)</option>
                            }
                        </select>
                        <span class="badge bg-secondary-lt fs-6">
                            <span data-visible-count>@Model.Rows.Count</span> / @Model.Rows.Count bản ghi
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.Rows.Any())
        {
            <div class="card-body text-center py-5">
                <i class="ti ti-database-off fs-1 text-muted d-block mb-2"></i>
                <h3 class="fw-bold text-dark">Chưa có dữ liệu trong mục này</h3>
                <p class="text-muted mb-0">Khi phát sinh hồ sơ hoặc nghiệp vụ, các bản ghi sẽ hiển thị tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover table-striped">
                    <thead>
                        <tr>
                            @foreach (var column in Model.Columns)
                            {
                                <th>@column</th>
                            }
                            @if (Model.Rows.Any(x => x.Actions.Count > 0))
                            {
                                <th class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rowState = row.State;
                            var badgeClass = rowState.Contains("contracted") || rowState.Contains("paid") || rowState.Contains("active") || rowState.Contains("resolved") || rowState.Contains("completed") ? "bg-success-lt text-success"
                                           : rowState.Contains("pending") || rowState.Contains("unpaid") || rowState.Contains("in_progress") ? "bg-warning-lt text-warning"
                                           : rowState.Contains("rejected") || rowState.Contains("cancelled") || rowState.Contains("overdue") ? "bg-danger-lt text-danger"
                                           : "bg-secondary-lt text-secondary";

                            <tr class="row-state-@row.State" data-filter-row data-row-state="@row.State">
                                <td class="fw-semibold text-dark">@row.Cells.ElementAtOrDefault(0)</td>
                                @for (var cellIndex = 1; cellIndex < row.Cells.Count; cellIndex++)
                                {
                                    <td>
                                        @if (cellIndex == row.Cells.Count - 1 && Model.Section != "reports")
                                        {
                                            <span class="badge @badgeClass">@row.Cells[cellIndex]</span>
                                        }
                                        else
                                        {
                                            @row.Cells[cellIndex]
                                        }
                                    </td>
                                }
                                @if (Model.Rows.Any(x => x.Actions.Count > 0))
                                {
                                    <td class="text-center">
                                        <div class="btn-list justify-content-center">
                                            @foreach (var action in row.Actions)
                                            {
                                                <form asp-controller="Dormitory" asp-action="Process" method="post" class="m-0">
                                                    <input type="hidden" name="section" value="@Model.Section" />
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    <input type="hidden" name="operation" value="@action.Operation" />
                                                    <button class="btn btn-sm @(action.Primary ? "btn-primary" : "btn-outline-secondary")" type="submit">
                                                        @action.Label
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-muted" data-filter-empty hidden>
                <i class="ti ti-info-circle me-1"></i> Không có bản ghi nào khớp với điều kiện lọc.
            </div>
        }
    </div>
}

<!-- ============================================== -->
<!-- 4. CREATE / ACTION FORM CARD                  -->
<!-- ============================================== -->
@if (Model.FormTitle is not null && Model.Fields.Count > 0)
{
    <div class="card shadow-sm border-0 mb-4" id="create-form">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center">
                <span class="avatar avatar-sm bg-primary-lt text-primary rounded me-2">
                    <i class="ti ti-plus fs-2"></i>
                </span>
                <div>
                    <h3 class="card-title fw-bold mb-0">@Model.FormTitle</h3>
                    <small class="text-muted">@(Model.FormHelp ?? "Thông tin sẽ được ghi nhận vào hồ sơ vận hành hệ thống.")</small>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Dormitory" asp-action="Create" method="post">
                <input type="hidden" name="section" value="@Model.Section" />
                <div class="row g-3">
                    @foreach (var field in Model.Fields)
                    {
                        var isFullWidth = field.Type == "textarea" || field.Name.Contains("note") || field.Name.Contains("address");
                        <div class="@(isFullWidth ? "col-12" : "col-md-6 col-lg-4")">
                            <label class="form-label fw-semibold">
                                @field.Label
                                @if (field.Required)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @if (field.Type == "select")
                            {
                                <select name="@field.Name" class="form-select" required="@(field.Required ? "required" : null)">
                                    <option value="">-- Chọn @field.Label.ToLowerInvariant() --</option>
                                    @foreach (var option in field.Options)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                            }
                            else if (field.Type == "textarea")
                            {
                                <textarea name="@field.Name" rows="3" class="form-control" required="@(field.Required ? "required" : null)" placeholder="Nhập @field.Label.ToLowerInvariant()..."></textarea>
                            }
                            else
                            {
                                <input name="@field.Name" type="@field.Type" class="form-control" required="@(field.Required ? "required" : null)" min="@(field.Type == "number" ? "0" : null)" step="@(field.Type == "number" ? "any" : null)" placeholder="Nhập @field.Label.ToLowerInvariant()..." />
                            }
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center justify-content-between mt-4 pt-3 border-top">
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="ti ti-check me-1"></i> Lưu thông tin dữ liệu
                    </button>
                    <span class="text-muted fs-6"><span class="text-danger">*</span> Các trường có dấu sao là bắt buộc.</span>
                </div>
            </form>
        </div>
    </div>
}
