                            <strong class="text-danger fs-4" id="vietQrAmountText">0 ₫</strong>
                            <button type="button" class="btn btn-outline-secondary btn-sm vietqr-copy-btn" id="vietQrCopyAmountBtn">Sao chép</button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted fs-6">Cú pháp đối soát:</span>
                        <div class="d-flex align-items-center gap-2">
                            <code class="text-primary fw-bold fs-6" id="vietQrContentText">KTX_...</code>
                            <button type="button" class="btn btn-outline-secondary btn-sm vietqr-copy-btn" id="vietQrCopyContentBtn">Sao chép</button>
                        </div>
                    </div>
                </div>

                <!-- Live note -->
                <div class="p-2 rounded bg-success-lt text-success fs-6 text-start">
                    <i class="ti ti-shield-check me-1"></i> Hệ thống tự động gạch nợ trong vòng 1-3 phút sau khi giao dịch thành công mà không cần gửi ảnh biên lai.
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success btn-sm px-3" onclick="confirmPaymentSuccess()">
                    <i class="ti ti-check me-1"></i> Tôi đã chuyển khoản xong
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     GLOBAL SCRIPT HELPERS (2D BLUEPRINT & VIETQR)
     ========================================================================== -->
<script>
    var currentSelectedBed = null;

    function showRoom2DBlueprint(roomNum, roomType, priceStr, genderStr, amenitiesStr, bedsList) {
        document.getElementById('room2DModalTitle').textContent = 'Sơ đồ 2D Phòng ' + roomNum;
        document.getElementById('room2DModalSubtitle').textContent = 'Mô phỏng mặt bằng không gian và định vị giường phòng ' + roomNum;
        document.getElementById('room2DTypeBadge').textContent = roomType;
        document.getElementById('room2DGenderBadge').textContent = genderStr;
        document.getElementById('room2DPriceDisplay').textContent = priceStr + ' ₫/tháng';

        // Render Amenities
        var amenContainer = document.getElementById('blueprintAmenitiesContainer');
        amenContainer.innerHTML = '';
        var amenities = amenitiesStr.split(',').filter(function(x) { return x.trim().length > 0; });
        amenities.forEach(function(amen) {
            var badge = document.createElement('span');
            badge.className = 'badge bg-light text-dark border p-2 fs-6';
            badge.innerHTML = '<i class="ti ti-check text-success me-1"></i> ' + amen.trim();
            amenContainer.appendChild(badge);
        });

        // Render Beds in 2D layout
        var bedsContainer = document.getElementById('blueprintBedsContainer');
        bedsContainer.innerHTML = '';
        currentSelectedBed = null;
        updateSelectedBedUI(null, roomNum);

        bedsList.forEach(function(bed, idx) {
            var col = document.createElement('div');
            col.className = 'col-6 col-md-3';

            var isAvail = bed.Status === 'available';
            var bedCard = document.createElement('div');
            bedCard.className = 'bunk-bed-2d ' + (isAvail ? 'bed-available' : 'bed-occupied');
            bedCard.id = 'bed-item-' + bed.Id;

            var pos = bed.Position || (idx % 2 === 0 ? 'Tầng 1 (Dưới)' : 'Tầng 2 (Trên)');
            var prox = bed.Proximity || (idx < 2 ? 'Cạnh cửa sổ' : (idx < 4 ? 'Gần quạt' : 'Cạnh cửa'));

            bedCard.innerHTML =
                '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<strong class="fs-4 text-dark"><i class="ti ti-bed me-1 text-primary"></i> ' + bed.BedNumber + '</strong>' +
                    '<span class="badge ' + (isAvail ? 'bg-success text-white' : 'bg-secondary text-white') + ' fs-6 px-1">' +
                        (isAvail ? 'Trống' : 'Đã ở') +
                    '</span>' +
                '</div>' +
                '<div class="text-muted fs-6 mb-1"><i class="ti ti-stairs me-1"></i> ' + pos + '</div>' +
                '<div class="text-secondary fs-6"><i class="ti ti-map-pin me-1"></i> ' + prox + '</div>';

            if (isAvail) {
                bedCard.onclick = function() {
                    // Deselect previous
                    document.querySelectorAll('.bunk-bed-2d').forEach(function(el) {
                        el.classList.remove('bed-selected');
                    });
                    bedCard.classList.add('bed-selected');
                    currentSelectedBed = bed;
                    updateSelectedBedUI(bed, roomNum);
                };
            }

            col.appendChild(bedCard);
            bedsContainer.appendChild(col);
        });

        var modal = new bootstrap.Modal(document.getElementById('room2DBlueprintModal'));
        modal.show();
    }

    function updateSelectedBedUI(bed, roomNum) {
        var titleEl = document.getElementById('blueprintSelectedBedTitle');
        var subEl = document.getElementById('blueprintSelectedBedSubtitle');
        var btnEl = document.getElementById('blueprintApplyBtn');

        if (bed) {
            titleEl.textContent = 'Bạn đang chọn: Giường ' + bed.BedNumber + ' (Phòng ' + roomNum + ')';
            subEl.textContent = (bed.Position || 'Tầng dưới') + ' · ' + (bed.Proximity || 'Gần cửa sổ') + ' · Trạng thái: Sẵn sàng đăng ký';
            btnEl.style.display = 'inline-flex';
            btnEl.href = '/Dormitory/Workspace?section=registrations#create-form';
        } else {
            titleEl.textContent = 'Chưa chọn giường nào';
            subEl.textContent = 'Nhấp vào một giường màu xanh lá trên sơ đồ để chọn giữ chỗ.';
            btnEl.style.display = 'none';
        }
    }

    function openVietQRModal(code, amountStr, contentStr) {
        // Strip non-numeric from amount
        var rawAmount = amountStr.replace(/[^0-9]/g, '') || '650000';
        var safeContent = encodeURIComponent(contentStr);

        var qrUrl = 'https://img.vietqr.io/image/970422-0389123456-compact2.png?amount=' + rawAmount + '&addInfo=' + safeContent + '&accountName=BAN%20QUAN%20LY%20KTX%20DAI%20HOC';
        
        document.getElementById('vietQrImageElement').src = qrUrl;
        document.getElementById('vietQrAmountText').textContent = parseInt(rawAmount).toLocaleString('vi-VN') + ' ₫';
        document.getElementById('vietQrContentText').textContent = contentStr;

        document.getElementById('vietQrCopyAmountBtn').onclick = function() {
            copyToClipboard(rawAmount, this);
        };
        document.getElementById('vietQrCopyContentBtn').onclick = function() {
            copyToClipboard(contentStr, this);
        };

        var modal = new bootstrap.Modal(document.getElementById('vietQrPaymentModal'));
        modal.show();
    }

    function copyToClipboard(text, btnElement) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function() {
                var oldText = btnElement.textContent;
                btnElement.textContent = 'Đã chép!';
                btnElement.classList.remove('btn-outline-secondary');
                btnElement.classList.add('btn-success');
                setTimeout(function() {
                    btnElement.textContent = oldText;
                    btnElement.classList.remove('btn-success');
                    btnElement.classList.add('btn-outline-secondary');
                }, 1500);
            });
        }
    }

    function confirmPaymentSuccess() {
        alert('Cảm ơn bạn! Hệ thống đã ghi nhận thông tin chuyển khoản và đang kích hoạt webhook đối soát gạch nợ tự động.');
        var modalEl = document.getElementById('vietQrPaymentModal');
        var modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
    }
</script>
